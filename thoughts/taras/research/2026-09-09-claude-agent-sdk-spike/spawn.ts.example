import { query } from "@anthropic-ai/claude-agent-sdk@0.3.266";
import { scrubSecrets } from "../../../../src/utils/secret-scrubber.ts";

const summary: Record<string, unknown> = {};
let run: ReturnType<typeof query> | undefined;
try {
  run = query({
    prompt: "This process will stop before any model request.",
    options: {
      pathToClaudeCodeExecutable: "/Users/taras/.local/bin/claude",
      settingSources: ["user", "project", "local"],
      systemPrompt: { type: "preset", preset: "claude_code", append: "x".repeat(150000) },
      extraArgs: { "append-system-prompt-file": "/tmp/sdk-fixture-prompt.md" },
      env: { PATH: process.env.PATH, HOME: process.env.HOME },
      spawnClaudeCodeProcess: (options) => {
        summary.command = options.command;
        summary.argumentCount = options.args.length;
        summary.longestArgument = Math.max(...options.args.map((arg) => arg.length));
        summary.arguments = options.args.map((arg) =>
          arg.length > 300 ? `<${arg.length} characters>` : arg,
        );
        summary.customSpawnInvoked = true;
        throw new Error("SPIKE_STOP_BEFORE_PROCESS_START");
      },
    },
  });
  for await (const _message of run) {
  }
} catch (error) {
  summary.stoppedAsExpected = String(error).includes("SPIKE_STOP_BEFORE_PROCESS_START");
} finally {
  run?.close();
}
const output = scrubSecrets(JSON.stringify(summary, null, 2));
await Bun.write("/tmp/claude-sdk-spike-20260909/spawn-result.json", output);
console.log(output);
