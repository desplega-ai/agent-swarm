diff --git a/packages/core/src/search/embeddings/openai-compat.ts b/packages/core/src/search/embeddings/openai-compat.ts
new file mode 100644
index 0000000..d9e296d
--- /dev/null
+++ b/packages/core/src/search/embeddings/openai-compat.ts
@@ -0,0 +1,73 @@
+import { createHash } from "node:crypto";
+import OpenAI from "openai";
+import type { EmbeddingProvider } from "./provider.js";
+import { requestBatches } from "./openai.js";
+
+export interface OpenAICompatOptions {
+  baseURL: string;
+  model: string;
+  /** Sent as a bearer token only when set. */
+  apiKey?: string;
+  queryPrefix?: string;
+  documentPrefix?: string;
+}
+
+/** TEI defaults to 32 inputs per request in older builds, 256 in 1.9.4. 32 is safe for both. */
+const MAX_INPUTS_PER_REQUEST = 32;
+const MAX_CHARS_PER_REQUEST = 250_000;
+
+/**
+ * Any server that speaks POST /v1/embeddings (TEI, vLLM, Ollama, LiteLLM).
+ * The model must return 768 dimensions natively: no `dimensions` is sent.
+ * `name` carries a hash of model + prefixes, because the re-embed fingerprint
+ * is only `<name>:v<rev>`. The base URL is left out so a host rename keeps the index.
+ */
+export class OpenAICompatEmbeddingProvider implements EmbeddingProvider {
+  readonly name: string;
+  readonly dimensions = 768;
+  private client: OpenAI;
+  private model: string;
+  private queryPrefix: string;
+  private documentPrefix: string;
+
+  constructor(opts: OpenAICompatOptions) {
+    this.model = opts.model;
+    this.queryPrefix = opts.queryPrefix ?? "";
+    this.documentPrefix = opts.documentPrefix ?? "";
+    const hash = createHash("sha256")
+      .update(JSON.stringify([this.model, this.queryPrefix, this.documentPrefix]))
+      .digest("hex")
+      .slice(0, 8);
+    this.name = `openai-compat-${hash}`;
+    // The SDK throws on an undefined key; the placeholder is never sent as a header
+    // when the caller passes no key (see defaultHeaders override below).
+    this.client = new OpenAI({
+      apiKey: opts.apiKey || "unused",
+      baseURL: opts.baseURL,
+      ...(opts.apiKey ? {} : { defaultHeaders: { Authorization: null as unknown as string } }),
+    });
+  }
+
+  async embedQuery(text: string): Promise<number[]> {
+    const result = await this.client.embeddings.create({
+      model: this.model,
+      input: this.queryPrefix + text,
+      encoding_format: "float",
+    });
+    return result.data[0].embedding;
+  }
+
+  async embedDocuments(texts: string[], _opts: { title: string }): Promise<number[][]> {
+    const vectors: number[][] = [];
+    const prefixed = texts.map((t) => this.documentPrefix + t);
+    for (const batch of requestBatches(prefixed, { inputs: MAX_INPUTS_PER_REQUEST, chars: MAX_CHARS_PER_REQUEST })) {
+      const result = await this.client.embeddings.create({
+        model: this.model,
+        input: batch,
+        encoding_format: "float",
+      });
+      vectors.push(...result.data.sort((a, b) => a.index - b.index).map((d) => d.embedding));
+    }
+    return vectors;
+  }
+}
