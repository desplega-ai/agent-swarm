# === Core ===
API_KEY=<redacted>
MCP_BASE_URL=http://localhost:3013
APP_URL=https://app.agent-swarm.dev
# Pin a release, e.g. AGENT_SWARM_VERSION=1.150.0. Blank tracks `latest`.
AGENT_SWARM_VERSION=
INSTALL_METHOD=onboard_noninteractive
INSTALL_PRESET=solo

# New-deployment memory preset: retrieval, citation ratings, self-rating hints.
# Set MEMORY_RATERS= to disable all raters; leave SKIP_SESSION_SUMMARY unset.
MEMORY_HYBRID_SEARCH=1
MEMORY_GRAPH_EXPANSION=1
MEMORY_RATERS=implicit-citation,explicit-self
MEMORY_DEMOTION_FLOOR=1.0

# === Authentication ===
HARNESS_PROVIDER=claude
ANTHROPIC_API_KEY=<redacted>

# === Integrations ===
GITHUB_DISABLE=true
SLACK_DISABLE=true

# === Agent IDs (for reference) ===
# worker-coder = 87dfb7ee-6a8a-4081-be61-003cfbc85c5c
