{
  "name": "@desplega.ai/agent-swarm",
  "version": "2.15.0",
  "description": "agent-swarm.dev — an open-source operating system for AI work: a lead agent breaks goals into tasks, routes them to specialized workers such as Claude Code or Codex, runs each worker in an isolated container, and preserves shared memory, tools, schedules, and review gates so delegated work compounds across sessions.",
  "keywords": [
    "agent-swarm.dev",
    "multi-agent orchestration",
    "AI agents",
    "Claude Code",
    "Codex",
    "agent swarm",
    "MCP",
    "AI agent framework",
    "autonomous agents",
    "Docker-isolated agents"
  ],
  "license": "MIT",
  "author": "desplega.sh <contact@desplega.sh>",
  "maintainers": [
    {
      "name": "Taras",
      "email": "t@desplega.sh"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desplega-ai/agent-swarm.git"
  },
  "bugs": {
    "url": "https://github.com/desplega-ai/agent-swarm/issues"
  },
  "homepage": "https://agent-swarm.dev",
  "mcpName": "io.github.desplega-ai/agent-swarm",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "src/",
    "tsconfig.json",
    "plugin/commands/",
    "plugin/agents/",
    "plugin/pi-skills/",
    "templates/",
    "vendored-openapi/",
    "openapi.json"
  ],
  "module": "src/http.ts",
  "type": "module",
  "bin": {
    "agent-swarm": "./dist/cli.js"
  },
  "@desplega.ai/agent-swarm": "link:@desplega.ai/agent-swarm",
  "config": {
    "name": "agent-swarm"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/ui",
    "apps/templates-ui",
    "apps/evals",
    "packages/*"
  ],
  "overrides": {
    "@slack/socket-mode": "^2.0.7",
    "lodash-es": "4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver"
  ],
  "scripts": {
    "build:realtime-browser": "bun scripts/build-realtime-browser.ts",
    "check:realtime-browser": "bun tsc -p src/realtime/tsconfig.browser.json && bun scripts/build-realtime-browser.ts --check",
    "build:pi-skills": "bun run plugin/build-pi-skills.ts",
    "build:skill-md": "bun scripts/build-skill-md.ts",
    "check:skill-md": "bun scripts/build-skill-md.ts --check",
    "build:seed-skill-files": "bun scripts/build-seed-skill-files.ts",
    "check:seed-skill-files": "bun scripts/build-seed-skill-files.ts --check",
    "sync:ai-toolbox-skills": "bun scripts/sync-ai-toolbox-skills.ts",
    "check:ai-toolbox-skills": "bun scripts/sync-ai-toolbox-skills.ts --check",
    "check:skill-sources": "bun scripts/check-skill-sources.ts",
    "build:docs-index": "bun scripts/build-docs-index.ts",
    "check:docs-index": "bun scripts/build-docs-index.ts --check",
    "check:operator-skill": "bun scripts/check-operator-skill.ts",
    "sync:telemetry-contract": "bun scripts/sync-telemetry-contract.ts",
    "check:telemetry-contract": "bun scripts/sync-telemetry-contract.ts --check",
    "build:telemetry-docs": "bun scripts/gen-telemetry-docs.ts",
    "check:telemetry-docs": "bun scripts/gen-telemetry-docs.ts --check",
    "build:claude-mod": "bun scripts/build-claude-mod.ts",
    "check:claude-mod": "bun scripts/build-claude-mod.ts --check",
    "test:claude-mod": "bash scripts/test-claude-mod.sh",
    "build:script-types": "bun scripts/bundle-script-types.ts",
    "build:extension-types": "bun scripts/bundle-extension-types.ts",
    "build:extension-schema": "bun scripts/build-extension-manifest-schema.ts",
    "check:extension-schema": "bun scripts/build-extension-manifest-schema.ts --check",
    "build:import-schema": "bun scripts/build-import-schema.ts",
    "check:import-schema": "bun scripts/build-import-schema.ts --check",
    "build:extension-catalog": "bun scripts/build-extension-catalog.ts",
    "check:extension-catalog": "bun scripts/build-extension-catalog.ts --check",
    "build:secret-rules": "bun scripts/gen-secret-rules.ts",
    "check:secret-rules": "bun scripts/gen-secret-rules.ts --check",
    "build:cli": "bun run scripts/build-cli.ts",
    "mono:build": "turbo run build",
    "mono:test": "turbo run test",
    "mono:lint": "turbo run lint",
    "mono:dev": "turbo run dev",
    "test:root": "bash scripts/run-bun-tests.sh",
    "test:storage": "bun test packages/storage-sqlite/test && bun run test:storage:postgres",
    "test:storage:postgres": "bun test --path-ignore-patterns='' packages/storage-postgres/test src/tests/request-memo-postgres.test.ts --timeout 30000",
    "e2e": "bun scripts/e2e/run.ts",
    "e2e:strict": "bun scripts/e2e/run.ts --strict",
    "e2e:bench": "bun scripts/e2e/bench.ts",
    "e2e:ui": "bun packages/ui-e2e/boot/run.ts",
    "e2e:ui:tsc": "bun tsc --noEmit -p packages/ui-e2e/tsconfig.json && bun tsc --noEmit -p packages/ui-e2e/tsconfig.boot.json",
    "e2e:visuals": "bun scripts/e2e/visuals.ts",
    "e2e:codex-oauth-blob": "bun scripts/e2e/codex-oauth-blob.ts",
    "e2e:tsc": "bun tsc --noEmit -p scripts/e2e/tsconfig.json",
    "prepack": "bun run build:cli",
    "check:local": "bash scripts/check.sh",
    "tsc:check": "bun check",
    "tsc:check:tsc": "bun tsc --noEmit",
    "check:db-boundary": "bash scripts/check-db-boundary.sh",
    "check:agents-md-size": "bash scripts/check-agents-md-size.sh",
    "check:codex-default-model": "bash scripts/check-codex-default-model.sh",
    "check:test-spawn-sync": "bash scripts/check-test-spawn-sync.sh",
    "check:storage-boundary": "bun scripts/storage-checks/check-storage-boundary.ts",
    "check:sql-portability": "bun scripts/storage-checks/check-sql-portability.ts",
    "check:tx-callbacks": "bun scripts/storage-checks/check-tx-callbacks.ts",
    "check:schema-parity": "bun scripts/storage-checks/check-schema-parity.ts",
    "check:no-new-triggers": "bun scripts/storage-checks/check-no-new-triggers.ts",
    "check:copy-migrations": "bun scripts/storage-checks/check-copy-migrations.ts",
    "storage:baseline": "bun scripts/storage/generate-postgres-baseline.ts",
    "check:dep-graph": "depcruise src packages/model-routing packages/agent-swarm-sdk packages/storage packages/storage-sqlite packages/storage-postgres --config .dependency-cruiser.cjs && bun scripts/storage-checks/check-driver-imports.ts",
    "check:api-key-boundary": "bash scripts/check-api-key-boundary.sh",
    "check:vendored-openapi": "bun scripts/check-vendored-openapi.ts",
    "check:rbac-coverage": "bun scripts/check-rbac-coverage.ts",
    "check:unit-test-allowlist": "bun scripts/check-unit-test-allowlist.ts",
    "check:openapi-response-coverage": "bun scripts/check-openapi-response-coverage.ts",
    "check:script-types": "bash scripts/check-script-types-freshness.sh",
    "check:audit-columns": "bash scripts/check-audit-columns.sh",
    "check:bun-version": "bun scripts/check-bun-version.ts",
    "check:playwright-version": "bun scripts/check-playwright-version.ts",
    "check:scenario-orders": "bun scripts/check-scenario-orders.ts --open-prs",
    "check:sandbox-spawn-skip-list": "bash scripts/check-sandbox-spawn-skip-list.sh",
    "lint:structure": "konsistent check",
    "prepare-release": "bun scripts/prepare-release.ts",
    "refresh:vendored-openapi": "bun scripts/refresh-vendored-openapi.ts",
    "sync-chart-version": "bun scripts/sync-chart-version.ts",
    "sync-plugin-versions": "bun scripts/sync-plugin-versions.ts",
    "check:plugin-versions": "bun scripts/sync-plugin-versions.ts --check",
    "bump:agent-fs": "bun scripts/bump-agent-fs.ts",
    "check-chart-version": "bun scripts/sync-chart-version.ts --check-if-package-version-changed",
    "cli": "bun src/cli.tsx",
    "hook": "bun src/hooks/hook.ts",
    "claude": "bun src/cli.tsx claude",
    "claude:headless": "bun src/cli.tsx claude --headless",
    "worker": "bun src/cli.tsx worker",
    "lead": "bun src/cli.tsx lead",
    "dev": "bun --hot src/stdio.ts",
    "dev:http": "NODE_ENV=development portless api.swarm bun --hot src/http.ts",
    "start": "bun src/stdio.ts",
    "start:http": "NODE_ENV=development bun --expose-gc src/http.ts",
    "start:portless": "portless api.swarm bun --expose-gc src/http.ts",
    "inspector": "bunx @modelcontextprotocol/inspector --transport stdio bun src/stdio.ts",
    "inspector:http": "bunx @modelcontextprotocol/inspector --transport http https://api.swarm.localhost:1355/mcp",
    "lint": "biome check src apps/evals packages/ui-e2e packages/model-routing packages/model-catalog packages/agent-swarm-sdk",
    "lint:slop": "bun --bun oxlint src apps/evals packages/ui-e2e packages/model-routing packages/model-catalog packages/agent-swarm-sdk",
    "lint:fix": "biome check --write src apps/evals packages/ui-e2e packages/model-routing packages/model-catalog packages/agent-swarm-sdk",
    "format": "biome format --write src",
    "build:binary": "bun build ./src/cli.tsx ./src/providers/pi-binary-root/src/extensions/codemode/worker.ts --root ./src/providers/pi-binary-root --compile --bytecode --format=esm --compile-exec-argv='--expose-gc' --target=bun-linux-x64 --outfile ./dist/agent-swarm",
    "build:binary:arm64": "bun build ./src/cli.tsx ./src/providers/pi-binary-root/src/extensions/codemode/worker.ts --root ./src/providers/pi-binary-root --compile --bytecode --format=esm --compile-exec-argv='--expose-gc' --target=bun-linux-arm64 --outfile ./dist/agent-swarm",
    "docker:build:api": "docker build -f Dockerfile -t agent-swarm-api:latest .",
    "docker:build:worker": "docker build -f Dockerfile.worker -t agent-swarm-worker:latest .",
    "docker:build:worker:slim": "docker build -f Dockerfile.worker --target worker-slim -t agent-swarm-worker:slim .",
    "docker:build:ui": "docker build -f Dockerfile.ui -t agent-swarm-ui:latest .",
    "docker:run:worker": "docker run --rm -it --env-file .env.docker -p 3202:3000 -v ./logs:/logs -v ./work/shared:/workspace/shared -v ./work/worker-1:/workspace/personal agent-swarm-worker:latest",
    "docker:run:lead": "docker run --rm -it --env-file .env.docker-lead -e AGENT_ROLE=lead -p 3201:3000 -v ./logs:/logs -v ./work/shared:/workspace/shared -v ./work/lead:/workspace/personal agent-swarm-worker:latest",
    "deploy:install": "bun deploy/install.ts",
    "deploy:update": "bun deploy/update.ts",
    "deploy:uninstall": "bun deploy/uninstall.ts",
    "deploy:docker": "bun deploy/docker-push.ts",
    "e2e:workflows": "bun scripts/e2e-workflow-test.ts",
    "e2e:workflows:docker": "bun scripts/e2e-workflow-test.ts --with-docker",
    "e2e:otel:jaeger": "bun scripts/e2e-otel-jaeger.ts",
    "docs:mcp": "bun scripts/generate-mcp-docs.ts",
    "docs:openapi": "bun scripts/generate-openapi.ts",
    "docs:business-use": "bun scripts/generate-business-use-docs.ts",
    "seed": "bun scripts/seed.ts",
    "seed:clean": "bun scripts/seed.ts --clean",
    "seed:people": "bun scripts/seed-people.ts",
    "seed:scripts": "bun scripts/seed-scripts.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@desplega.ai/slack-mock": "^0.7.0",
    "@desplega/model-catalog": "workspace:*",
    "@desplega/model-routing": "workspace:*",
    "@desplega/storage": "workspace:*",
    "@desplega/storage-postgres": "workspace:*",
    "@desplega/storage-sqlite": "workspace:*",
    "@faker-js/faker": "^10.6.0",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "latest",
    "dependency-cruiser": "^18.8.0",
    "emulate": "0.14.0",
    "happy-dom": "^21.0.4",
    "konsistent": "1.0.0-beta.13",
    "openapi-typescript": "^7",
    "oxlint": "1.94.0",
    "ts-morph": "^28.0.0",
    "turbo": "^2.11.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.12"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.12.0",
    "@ai-sdk/openai": "^3.0.144",
    "@anthropic-ai/claude-agent-sdk": "0.3.332",
    "@anthropic-ai/sdk": "^1.14.0",
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-bedrock": "3.1171.0",
    "@boxd-sh/sdk": "0.3.2",
    "@chat-adapter/discord": "4.45.0",
    "@chat-adapter/shared": "4.45.0",
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/teams": "4.45.0",
    "@chat-adapter/telegram": "4.45.0",
    "@cursor/sdk": "1.5.0",
    "@desplega.ai/agent-fs-just-bash": "0.18.38",
    "@desplega.ai/business-use": "^0.4.3",
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@inkjs/ui": "^2.0.0",
    "@ironcalc/wasm": "0.9.1",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@json-render/chat": "0.23.1",
    "@json-render/core": "0.23.1",
    "@linear/sdk": "^77.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex": "0.172.0",
    "@openfort/openfort-node": "^0.14.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@slack/bolt": "^4.7.3",
    "@slack/web-api": "7.19.0",
    "@types/react": "^19.3.0",
    "@x402/core": "^2.31.0",
    "@x402/evm": "^2.31.0",
    "@x402/fetch": "^2.31.0",
    "ai": "^6.0.333",
    "chat": "4.45.0",
    "cron-parser": "^5.10.6",
    "date-fns": "^4.4.0",
    "e2b": "2.64.0",
    "fractional-indexing": "4.0.0",
    "ink": "^6.8.0",
    "just-bash": "3.6.0",
    "oauth4webapi": "^3.8.8",
    "openai": "^6.49.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.1",
    "react-devtools-core": "^7.0.1",
    "sqlite-vec": "^0.1.9",
    "svix": "^1.99.1",
    "viem": "^2.58.0",
    "ws": "8.23.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-protocols": "1.0.7",
