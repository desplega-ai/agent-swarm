{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh ../../scripts/vercel-ignore.sh apps/ui packages/model-catalog src/utils/task-citations.ts src/utils/dsh-usage.ts src/be/modelsdev-cache.json src/themes",
  "functions": {
    "api/og.ts": {
      "includeFiles": "{og/fonts/space-grotesk-400.ttf,og/fonts/space-grotesk-500.ttf,og/fonts/space-mono-400.ttf,og/mascot-lead.png,public/logo.png}"
    }
  },
  "rewrites": [
    {
      "source": "/pages/:id([A-Za-z0-9_-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Slackbot|Slack-ImgProxy|Twitterbot|LinkedInBot|facebookexternalhit|Facebot|meta-externalagent|Discordbot|WhatsApp|TelegramBot|Applebot|redditbot|Mastodon|Bluesky|Embedly|SkypeUriPreview|Pinterestbot|Iframely|vkShare|Googlebot|bingbot|DuckDuckBot|Snapchat).*"
        }
      ],
      "destination": "/api/page-share?id=:id"
    },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/pages/:id([A-Za-z0-9_-]+)",
      "headers": [{ "key": "Vary", "value": "User-Agent" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
