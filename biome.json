{
  "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!!docs-site/.next",
      "!src/be/seed-scripts/catalog",
      "!src/be/modelsdev-cache.json",
      "!src/extensions/catalog.generated.json",
      "!src/telemetry-contract/catalog.json",
      "!src/telemetry-contract/types.gen.ts",
      "!src/utils/secret-rules.generated.ts",
      "!templates/extensions/manifest.schema.json",
      "!packages/ui-e2e/reporter/ui-e2e-ingest.v1.schema.json",
      "!mockups",
      "!claude-mod/vendor/logs-parser.js",
      "!talks",
      "!templates/community/open-prompt-showreel/example/tla-races/reel.html",
      "!!docs-site/public/openapi.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noBannedTypes": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTemplateCurlyInString": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "src/tests/**", "claude-mod/tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/utils/business-use.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@desplega.ai/business-use": "Import from src/utils/business-use.ts instead: its ensure() scrubs secrets from event data before it leaves the process."
                }
              }
            }
          }
        }
      }
    }
  ]
}
