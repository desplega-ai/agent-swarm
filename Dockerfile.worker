# Agent Swarm Worker Dockerfile
# Runs a harness (claude / pi / codex / opencode) in headless loop mode as a
# worker agent.
#
# Stage graph (see runbooks/docker-images.md):
#   prek, builder                — pinned tool + compiled agent-swarm binary
#   worker-base                  — minimal system + ALL four harness CLIs
#   worker-slim  (target)        — worker-base + repo artifacts. For CI + E2E.
#   worker-full-base             — worker-base + dev toolchain, Playwright
#                                  Chromium + agent-browser, postgres/redis,
#                                  glab, context-mode plugins
#   worker-full  (target, LAST)  — worker-full-base + repo artifacts. Default
#                                  build; published as :latest.
#
# The repo-artifact block (binary, plugin/ trees, entrypoint) is duplicated in
# the two leaf stages ON PURPOSE: putting it in worker-base would invalidate
# every heavy worker-full-base layer on each code change. Keep the two blocks
# in sync (marked "leaf block" below).

ARG PREK_VERSION=0.4.5
ARG SKILLS_CLI_VERSION=1.5.20

# Official prek docs recommend copying the pinned binary from its distroless
# image into Debian-based images.
FROM ghcr.io/j178/prek:v${PREK_VERSION} AS prek

# ─── Stage: builder ──────────────────────────────────────────────────────────
FROM oven/bun:1.4.0 AS builder
WORKDIR /build
# Root package.json declares Bun workspaces (apps/{ui,templates-ui,evals}); their manifests +
# bunfig.toml (pins linker="hoisted"; the workspace default "isolated" would hide the
# root's phantom transitive deps and break the compile) must be present for the frozen
# install to resolve the workspace graph. Member deps land in the builder only; the final
# image copies just the compiled binary, so image size is unaffected.
COPY package.json bun.lock* bunfig.toml ./
COPY apps/ui/package.json ./apps/ui/package.json
COPY apps/templates-ui/package.json ./apps/templates-ui/package.json
COPY apps/evals/package.json ./apps/evals/package.json
RUN bun install --frozen-lockfile
COPY src/ ./src/
COPY templates/ ./templates/
COPY tsconfig.json ./
# --bytecode --format=esm (Bun 1.4 lifted the CJS-only restriction): the binary
# boots on every container start AND every hook invocation, so the ~4x faster
# startup (388 -> 81 ms measured) is worth the ~130 MB larger binary.
RUN bun build ./src/cli.tsx --compile --bytecode --format=esm --compile-exec-argv='--expose-gc' --outfile ./agent-swarm

# ─── Stage: worker-base — minimal system + all harness CLIs ──────────────────
FROM ubuntu:24.04 AS worker-base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Use pipefail so pipe failures are caught
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Minimal system packages: enough to boot the entrypoint, auth with GitHub,
# clone repos, and run any of the four harnesses. Dev toolchain, postgres,
# Playwright, glab etc. are worker-full-base additions.
# Step 1: bootstrap curl/gnupg so we can add external apt repos
# Step 2: add NodeSource + GitHub CLI repos, then install the slim set
RUN apt-get update && apt-get install -y curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends \
    wget lsb-release \
    git git-lfs \
    nano \
    python3 python3-pip python3-venv \
    jq unzip zip tar gzip sqlite3 gosu tini \
    openssh-client \
    postgresql-client \
    nodejs \
    gh \
    && rm -rf /var/lib/apt/lists/*

# Install Bun once, system-wide at /usr/local/bin (shared by root and worker —
# runbook rule 4: never install a toolchain twice). Runtime `bun i -g` for the
# worker user still lands in ~/.bun via the BUN_INSTALL ENV set below.
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash -s "bun-v1.4.0"

# Create non-root user for runtime execution.
# NOTE: Container entrypoint runs as root (setup, chown, privileged mounts).
# Final exec drops to worker via gosu (Claude rejects --dangerously-skip-permissions as root).
# Worker user retained for file ownership and Claude process execution.
RUN useradd -m -s /bin/bash worker

USER worker
WORKDIR /home/worker
ENV HOME=/home/worker
ENV BUN_INSTALL="/home/worker/.bun"

# Redirect corepack home to user-writable directory (default /usr/lib/node_modules/
# requires root and causes "operation rejected by your operating system" errors)
ENV COREPACK_HOME=/home/worker/.corepack
RUN mkdir -p /home/worker/.corepack

# Pre-create XDG dirs as worker so that later root-level steps writing into
# /home/worker (HOME is still set to /home/worker under USER root) don't leave
# /home/worker/.local root-owned and break worker-side mkdir into .local/share.
RUN mkdir -p /home/worker/.local/bin /home/worker/.local/share /home/worker/.local/state

# Bun binary is system-wide (/usr/local/bin); ~/.bun/bin stays on PATH for
# runtime worker-scoped global installs.
ENV PATH="/home/worker/.bun/bin:$PATH"

# gh v2.90+ only offers to install gh-stack interactively, which never fires
# in headless workers. Install the official extension explicitly as the runtime
# user; a transient GitHub failure should warn without blocking the image build.
RUN if ! gh extension install github/gh-stack; then \
      echo "WARNING: failed to install github/gh-stack; continuing without gh stack" >&2; \
    fi

# Install Claude CLI (pinned version — bump ARG to update)
ARG CLAUDE_CODE_VERSION=2.1.258
USER root
RUN HOME=/root NPM_CONFIG_CACHE=/tmp/npm-cache \
    npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && rm -rf /tmp/npm-cache /root/.npm
USER worker
# Verify claude binary is findable after install
RUN which claude && claude --version
ENV DISABLE_AUTOUPDATER=1
ENV PATH="/home/worker/.local/bin:$PATH"

# Install pi-mono CLI (alternative harness, selected via HARNESS_PROVIDER=pi)
# PI_PACKAGE_DIR tells pi-mono where to find its package.json at runtime
# (needed because bun --compile makes process.execPath resolve to the binary location)
ARG PI_CODING_AGENT_VERSION=0.84.4
USER root
RUN HOME=/root NPM_CONFIG_CACHE=/tmp/npm-cache \
    npm install -g @earendil-works/pi-coding-agent@${PI_CODING_AGENT_VERSION} \
    && rm -rf /tmp/npm-cache /root/.npm
USER worker
RUN mkdir -p /home/worker/.pi/agent
ENV PI_PACKAGE_DIR=/usr/lib/node_modules/@earendil-works/pi-coding-agent

# Install Codex CLI (alternative harness, selected via HARNESS_PROVIDER=codex)
# Pinned version must match @openai/codex-sdk in package.json — enforced by
# scripts/check-codex-default-model.sh and the CI merge gate.
ARG CODEX_VERSION=0.152.1
USER root
RUN HOME=/root NPM_CONFIG_CACHE=/tmp/npm-cache \
    npm install -g @openai/codex@${CODEX_VERSION} \
    && rm -rf /tmp/npm-cache /root/.npm
USER worker
RUN which codex && codex --version

# The @openai/codex-sdk bundled inside the compiled agent-swarm binary cannot
# resolve `require.resolve("@openai/codex")` at runtime because the globally-
# installed package is not part of the Bun bundle. Point the SDK at the global
# Codex CLI wrapper via CODEX_PATH_OVERRIDE so `src/providers/codex-adapter.ts`
# forwards it to `new Codex({ codexPathOverride })`. The wrapper is a node
# shebang script that resolves the platform-specific native binary itself.
ENV CODEX_PATH_OVERRIDE=/usr/bin/codex

# Baseline ~/.codex/config.toml for the worker user. The `model` key must stay
# in sync with CODEX_DEFAULT_MODEL in src/providers/codex-models.ts (enforced by
# scripts/check-codex-default-model.sh).
RUN mkdir -p /home/worker/.codex && \
    printf '%s\n' \
      'model = "gpt-5.6-terra"' \
      'approval_policy = "never"' \
      'sandbox_mode = "danger-full-access"' \
      'skip_git_repo_check = true' \
      'show_raw_agent_reasoning = false' \
      '' \
      '[features]' \
      'hooks = true' \
      'plugin_hooks = true' \
      > /home/worker/.codex/config.toml && \
    chown -R worker:worker /home/worker/.codex

# Install opencode CLI + SDK (alternative harness, selected via HARNESS_PROVIDER=opencode)
# CLI version must match SDK version — the SDK spawns `opencode serve` and parses
# its stdout for the listening URL (see node_modules/@opencode-ai/sdk/dist/server.js).
# The installer drops the binary at ~/.opencode/bin/opencode and only modifies
# ~/.bashrc — non-interactive shells (entrypoint, gosu drops) miss that PATH
# update, so we extend ENV PATH explicitly.
ARG OPENCODE_VERSION=1.18.26
RUN curl -fsSL https://opencode.ai/install | VERSION=${OPENCODE_VERSION} bash
ENV PATH="/home/worker/.opencode/bin:$PATH"
ARG OPENCODE_SDK_VERSION=1.18.26
USER root
RUN HOME=/root NPM_CONFIG_CACHE=/tmp/npm-cache \
    npm install -g @opencode-ai/sdk@${OPENCODE_SDK_VERSION} \
    && rm -rf /tmp/npm-cache /root/.npm
USER worker

# Install context-mode CLI globally (context-window compression tools for all
# harnesses). The global install puts `context-mode` on PATH (for Claude/Codex
# stdio MCP) AND makes the package importable (for the OpenCode in-process
# plugin). The Claude/Codex plugin installs (worker-full-base) provide the
# hooks; this provides the CLI binary + package importability. Disable
# per-worker via CONTEXT_MODE_DISABLED=true (read by the adapters at runtime).
ARG CONTEXT_MODE_VERSION=1.0.169
USER root
RUN HOME=/root NPM_CONFIG_CACHE=/tmp/npm-cache \
    npm install -g context-mode@${CONTEXT_MODE_VERSION} \
    && rm -rf /tmp/npm-cache /root/.npm
USER worker

# Install prek for opt-in worker repo hook setup.
COPY --from=prek /prek /usr/local/bin/prek

# Install CLI-coupled skills with `npx skills` (vercel-labs skills-only
# installer), pinned to tags for reproducible builds. agent-fs is the only
# one. The ai-toolbox catalog (including the `agent-browser` and `qa` skills)
# is DB-seeded from templates/skills/ instead. Deliberately NOT `|| true`-guarded:
# a pinned fetch failure should fail the build.
# Gotcha (vercel-labs/skills#851): global claude-code installs occasionally
# land only in ~/.agents/skills — the `test -e` asserts catch that, and the
# mirror step in the leaf stages dereferences symlinks when fanning out to
# other harnesses.
ARG SKILLS_CLI_VERSION
# agent-fs version pins BOTH the skill source tag (here) and the CLI in
# /opt/global-deps (below). Bump with `bun run bump:agent-fs` so the chart,
# Compose, and docs pins move in lockstep with this ARG.
ARG AGENT_FS_VERSION=0.13.5
RUN npx -y skills@${SKILLS_CLI_VERSION} add desplega-ai/agent-fs@v${AGENT_FS_VERSION} --skill agent-fs -g -a claude-code -y \
    && test -e /home/worker/.claude/skills/agent-fs/SKILL.md \
    && rm -rf /home/worker/.npm

# Configure wts for agent mode (no tmux, no auto-Claude)
RUN mkdir -p /home/worker/.wts \
    && echo '{"defaults":{"autoTmux":false,"autoClaude":false}}' > /home/worker/.wts/config.json

# Setup .claude directory and settings
RUN mkdir -p /home/worker/.claude/commands /home/worker/.claude/agents \
    && echo '{"hasCompletedOnboarding":true,"bypassPermissionsModeAccepted":true}' > /home/worker/.claude.json \
    && echo '{ \
  "permissions": { "allow": ["mcp__agent-swarm__*", "mcp__context-mode__*"], "deny": ["AskUserQuestion", "NotebookEdit", "EnterPlanMode", "ExitPlanMode", "Artifact", "Workflow", "ReportFindings"] }, \
  "outputStyle": "Concise", \
  "disableBundledSkills": true, \
  "disableRemoteControl": true, \
  "disableClaudeAiConnectors": true, \
  "enableAllProjectMcpServers": true, \
  "enabledMcpjsonServers": ["agent-swarm", "context-mode"], \
  "hooks": { \
    "SessionStart": [{"matcher": "*", "hooks": [{"type": "command", "command": "/usr/local/bin/agent-swarm hook"}]}], \
    "UserPromptSubmit": [{"matcher": "*", "hooks": [{"type": "command", "command": "/usr/local/bin/agent-swarm hook"}]}], \
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "/usr/local/bin/agent-swarm hook"}]}], \
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "/usr/local/bin/agent-swarm hook"}]}], \
    "PreCompact": [{"matcher": "*", "hooks": [{"type": "command", "command": "/usr/local/bin/agent-swarm hook"}]}], \
    "Stop": [{"matcher": "*", "hooks": [{"type": "command", "command": "/usr/local/bin/agent-swarm hook"}]}] \
  } \
}' > /home/worker/.claude/settings.json

# Codex steering hooks as ADMIN-MANAGED requirements: /etc/codex/requirements.toml
# hooks are "managed, trusted by policy" (developers.openai.com/codex/hooks), so
# they run without the per-hook trusted_hash review that user-level hooks.json
# needs — codex silently skips untrusted hooks, which in a headless worker means
# steering would never deliver. PreToolUse is deliberately absent: codex drops
# its additionalContext (openai/codex#19385). Runtime no-ops unless
# STEERING_ENABLED reaches the codex env (live-reconciled by the runner).
# Root-owned on purpose: it's the admin-enforced layer (and /etc needs root).
USER root
RUN mkdir -p /etc/codex && printf '%s\n' \
  '[features]' \
  'hooks = true' \
  '' \
  '[[hooks.SessionStart]]' \
  '[[hooks.SessionStart.hooks]]' \
  'type = "command"' \
  'command = "/usr/local/bin/agent-swarm codex-hook"' \
  '' \
  '[[hooks.PostToolUse]]' \
  '[[hooks.PostToolUse.hooks]]' \
  'type = "command"' \
  'command = "/usr/local/bin/agent-swarm codex-hook"' \
  '' \
  '[[hooks.Stop]]' \
  '[[hooks.Stop.hooks]]' \
  'type = "command"' \
  'command = "/usr/local/bin/agent-swarm codex-hook"' \
  > /etc/codex/requirements.toml
USER worker

# Base global npm tools (pinned versions for cache stability): the set the
# entrypoint and core agent workflows depend on. Full-image extras
# (agent-browser, playwright, sentry-cli, localtunnel, claude-bridge) live in a
# SEPARATE staging dir in worker-full-base so this layer is never rewritten.
#
# Staging-dir `npm install` + symlink pattern (instead of `npm install -g`) so
# we can apply `overrides` for broken/bloated upstream transitives:
#   @desplega.ai/agent-fs -> chonkie -> @huggingface/hub@2.11.1
#     -> @huggingface/xetchunk-wasm@0.0.4
# xetchunk-wasm@0.0.4 was published with `gearhash-jit: workspace:*` and
# `@huggingface/blake3-jit: workspace:*` — neither sibling is on npm, so a
# global install hits EUNSUPPORTEDPROTOCOL in uncached environments. Pinning
# `@huggingface/hub` to 2.11.0 (the last version before xetchunk-wasm became
# a dep) sidesteps it. Drop this workaround once HF republishes a clean
# xetchunk-wasm and chonkie / agent-fs pull it in.
#
# onnxruntime-* / node-llama-cpp (~360 MB) back agent-fs's LOCAL embedding
# path only — the swarm always talks to a shared agent-fs API (server-side
# indexing), and agent-fs imports them lazily (`await import(...)`), so the
# stubs only surface if someone forces local embeddings inside a worker.
# @duckdb/node-api is intentionally NOT stubbed: `agent-fs` SQL-over-files
# runs client-side and the skill actively advertises it.
USER root
# NOTE: heredoc delimiter is intentionally UNQUOTED so ${AGENT_FS_VERSION}
# expands — keep the JSON free of other `$`/backticks.
RUN mkdir -p /opt/global-deps && cat > /opt/global-deps/package.json <<EOF
{
  "name": "global-deps",
  "private": true,
  "dependencies": {
    "pm2": "6.0.14",
    "@desplega.ai/wts": "0.2.3",
    "@desplega.ai/agent-fs": "${AGENT_FS_VERSION}"
  },
  "overrides": {
    "@huggingface/hub": "2.11.0",
    "chromadb": "npm:empty-npm-package@1.0.0",
    "chromadb-default-embed": "npm:empty-npm-package@1.0.0",
    "@xenova/transformers": "npm:empty-npm-package@1.0.0",
    "tree-sitter-wasms": "npm:empty-npm-package@1.0.0",
    "web-tree-sitter": "npm:empty-npm-package@1.0.0",
    "cohere-ai": "npm:empty-npm-package@1.0.0",
    "voyageai": "npm:empty-npm-package@1.0.0",
    "ollama": "npm:empty-npm-package@1.0.0",
    "onnxruntime-node": "npm:empty-npm-package@1.0.0",
    "onnxruntime-web": "npm:empty-npm-package@1.0.0",
    "node-llama-cpp": "npm:empty-npm-package@1.0.0"
  }
}
EOF

# CRITICAL: `ENV HOME=/home/worker` is still active under `USER root`, so
# without the inline override npm would dump ~/.npm into /home/worker as
# root-owned files (see runbook rule 2). Caches cleaned in the SAME RUN.
RUN HOME=/root NPM_CONFIG_CACHE=/tmp/npm-cache \
    sh -c 'cd /opt/global-deps && npm install --no-audit --no-fund \
      && for bin in /opt/global-deps/node_modules/.bin/*; do \
           ln -sf "$bin" "/usr/local/bin/$(basename "$bin")"; \
         done' \
    && rm -rf /tmp/npm-cache /root/.npm /root/.cache

# Runtime environment shared by all leaf stages
ENV AGENT_ROLE=worker
ENV HARNESS_PROVIDER=claude
ENV WORKER_YOLO=false
ENV MCP_BASE_URL=http://host.docker.internal:3013
ENV WORKER_LOG_DIR=/logs
ENV LEAD_LOG_DIR=/logs
ENV WORKER_SYSTEM_PROMPT=""
ENV WORKER_SYSTEM_PROMPT_FILE=""
ENV LEAD_SYSTEM_PROMPT=""
ENV LEAD_SYSTEM_PROMPT_FILE=""
ENV STARTUP_SCRIPT_STRICT=false
ENV TEMPLATE_REGISTRY_URL=https://templates.agent-swarm.dev
ENV PM2_HOME=/workspace/.pm2
ENV PATH="/home/worker/.local/bin:/home/worker/.bun/bin:$PATH"
ENV OPENCODE_SWARM_PLUGIN_PATH=/home/worker/.config/opencode/plugins/agent-swarm.ts

VOLUME ["/logs"]

# Expose service port for PM2 processes
EXPOSE 3000

ENTRYPOINT ["/docker-entrypoint.sh"]

# ─── Stage: worker-slim — CI/E2E image (all harnesses, no extras) ────────────
FROM worker-base AS worker-slim

# ==== leaf block — KEEP IN SYNC with the identical block in worker-full ====
# Repo artifacts change on every code change; they live only in leaf stages so
# the heavy shared layers above never get invalidated by a src/ edit.

# Copy binary from builder.
# --chmod avoids a separate `RUN chmod` layer that would duplicate the binary.
COPY --from=builder --chmod=755 /build/agent-swarm /usr/local/bin/agent-swarm

# Optional helpers (postgres/redis only exist in the full image; the
# entrypoint guards on the binaries before invoking these)
COPY --chmod=755 scripts/init-local-postgres.sh /usr/local/bin/init-local-postgres.sh
COPY --chmod=755 scripts/init-local-redis.sh /usr/local/bin/init-local-redis.sh
COPY --chmod=755 scripts/install-repo-hooks.sh /usr/local/bin/install-repo-hooks.sh

# Copy commands / agents
COPY --chown=worker:worker plugin/commands/* /home/worker/.claude/commands/
COPY --chown=worker:worker plugin/agents/* /home/worker/.claude/agents/

# Copy pi-mono skills (used when HARNESS_PROVIDER=pi)
COPY --chown=worker:worker plugin/pi-skills/ /home/worker/.pi/agent/skills/

# Copy codex skills (used when HARNESS_PROVIDER=codex)
# Structure: plugin/commands/<name>.md -> ~/.codex/skills/<name>/SKILL.md
COPY --chown=worker:worker plugin/commands/ /tmp/codex-skills-src/
RUN mkdir -p /home/worker/.codex/skills && \
    for f in /tmp/codex-skills-src/*.md; do \
      [ -e "$f" ] || continue; \
      name=$(basename "$f" .md); \
      mkdir -p "/home/worker/.codex/skills/$name"; \
      cp "$f" "/home/worker/.codex/skills/$name/SKILL.md"; \
    done && \
    rm -rf /tmp/codex-skills-src && \
    chown -R worker:worker /home/worker/.codex/skills

# Mirror Claude-installed skills into every local harness skill tree (repo
# skills + `npx skills` installs). -L dereferences symlinks (npx skills may
# symlink into ~/.agents/skills).
# NOTE: chown ONLY the skill trees written here. A `chown -R` over the parent
# dotdirs (.opencode is 171 MB, .codex 90 MB) rewrites them into this layer
# (runbook rule 1) — previously a 270 MB layer for 88 KB of skills.
RUN mkdir -p /home/worker/.pi/agent/skills /home/worker/.codex/skills /home/worker/.opencode/skills /home/worker/.agents/skills && \
    cp -aL /home/worker/.claude/skills/. /home/worker/.pi/agent/skills/ || true && \
    cp -aL /home/worker/.claude/skills/. /home/worker/.codex/skills/ || true && \
    cp -aL /home/worker/.claude/skills/. /home/worker/.opencode/skills/ || true && \
    cp -aL /home/worker/.claude/skills/. /home/worker/.agents/skills/ || true && \
    chown -R worker:worker /home/worker/.pi/agent/skills /home/worker/.codex/skills \
      /home/worker/.opencode/skills /home/worker/.agents

# Copy opencode plugin (used when HARNESS_PROVIDER=opencode).
# OPENCODE_SWARM_PLUGIN_PATH (ENV in worker-base) tells OpencodeAdapter exactly
# where to find the plugin. The plugin entrypoint imports adjacent vendored
# helpers (`./opencode-auth`, `./summarize`) — opencode's plugin loader runs
# the TS files inside its own bundled Bun runtime, which only exposes
# `@opencode-ai/{plugin,sdk}`, so the helpers are vendored next to it. Tests
# live in a sibling `tests/` subdirectory and are intentionally NOT copied
# (opencode auto-discovers `.ts` files here and would load them as plugins).
RUN mkdir -p /home/worker/.config/opencode/plugins/lib && \
    chown -R worker:worker /home/worker/.config
COPY --chown=worker:worker plugin/opencode-plugins/agent-swarm.ts /home/worker/.config/opencode/plugins/agent-swarm.ts
COPY --chown=worker:worker plugin/opencode-plugins/lib/ /home/worker/.config/opencode/plugins/lib/

# Workspace directories (bind-mounted or volume-backed at runtime) + entrypoint
RUN mkdir -p /workspace/personal /workspace/shared /logs && \
    chown worker:worker /workspace /logs
COPY --chown=worker:worker --chmod=755 docker-entrypoint.sh /docker-entrypoint.sh

USER root
WORKDIR /workspace
# ==== end leaf block ====

# ─── Stage: worker-full-base — dev toolchain + Playwright + services ─────────
FROM worker-base AS worker-full-base

USER root

# Full dev-environment extras. NOTE: intentionally NOT using
# --no-install-recommends — agents build arbitrary projects; recommended
# packages (setuptools, wheel, less, dev headers, etc.) prevent subtle
# breakage. python3-{dev,setuptools,wheel} are explicit because worker-base
# installs python with --no-install-recommends.
# Postgres + redis servers back the SWARM_DEP_POSTGRES_ENABLED /
# SWARM_DEP_REDIS_ENABLED opt-in features (started by the entrypoint).
RUN apt-get update && apt-get install -y \
    vim tree htop tmux \
    build-essential make cmake gcc g++ \
    python3-dev python3-setuptools python3-wheel \
    fuse3 libfuse2 \
    postgresql-16 \
    postgresql-16-pgvector \
    postgresql-contrib-16 \
    redis-server redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Install GitLab CLI (glab) for GitLab integration
ARG GLAB_VERSION=1.89.0
ARG TARGETARCH
RUN curl -fsSL "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/${GLAB_VERSION}/glab_${GLAB_VERSION}_linux_${TARGETARCH}.deb" -o /tmp/glab.deb \
    && dpkg -i /tmp/glab.deb \
    && rm /tmp/glab.deb

# Playwright browsers live in a system path so they're shared across users at
# runtime AND so the install doesn't pollute /home/worker (which would force a
# multi-GB chown layer). The ENV is also read by Playwright at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

# Install the Ubuntu 24.04 packages Playwright's Chromium binary needs at
# runtime. `playwright install chromium` (below) only installs the browser
# binary itself; it does not apt-install these shared libs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      libasound2t64 \
      libatk-bridge2.0-0t64 \
      libatk1.0-0t64 \
      libatspi2.0-0t64 \
      libcairo2 \
      libcups2t64 \
      libdbus-1-3 \
      libdrm2 \
      libgbm1 \
      libglib2.0-0t64 \
      libnspr4 \
      libnss3 \
      libpango-1.0-0 \
      libx11-6 \
      libxcb1 \
      libxcomposite1 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

# Full-image global npm tools, staged in a SEPARATE dir from worker-base's
# /opt/global-deps so its layer is never rewritten. Same overrides rationale
# as worker-base (see that heredoc's comment).
#
# agent-browser (vercel-labs; native binary + Node launcher) is the workers'
# browser-automation CLI. It drives Chrome over CDP and reuses Playwright's
# Chromium through AGENT_BROWSER_EXECUTABLE_PATH (set below), so the image
# ships exactly ONE browser. playwright is a direct dep, pinned to the version
# the retired qa-use CLI used to pull in, because `playwright install chromium`
# is what puts that browser into /opt/playwright.
RUN mkdir -p /opt/global-deps-full && cat > /opt/global-deps-full/package.json <<'EOF'
{
  "name": "global-deps-full",
  "private": true,
  "dependencies": {
    "@sentry/cli": "3.3.4",
    "@desplega.ai/localtunnel": "2.2.0",
    "@desplega.ai/claude-bridge": "0.2.2",
    "agent-browser": "0.31.1",
    "playwright": "1.58.0"
  },
  "overrides": {
    "@huggingface/hub": "2.11.0",
    "chromadb": "npm:empty-npm-package@1.0.0",
    "chromadb-default-embed": "npm:empty-npm-package@1.0.0",
    "@xenova/transformers": "npm:empty-npm-package@1.0.0",
    "tree-sitter-wasms": "npm:empty-npm-package@1.0.0",
    "web-tree-sitter": "npm:empty-npm-package@1.0.0",
    "cohere-ai": "npm:empty-npm-package@1.0.0",
    "voyageai": "npm:empty-npm-package@1.0.0",
    "ollama": "npm:empty-npm-package@1.0.0",
    "onnxruntime-node": "npm:empty-npm-package@1.0.0",
    "onnxruntime-web": "npm:empty-npm-package@1.0.0",
    "node-llama-cpp": "npm:empty-npm-package@1.0.0"
  }
}
EOF

# Install full global deps + Playwright chromium. CRITICAL: `ENV
# HOME=/home/worker` is still active under `USER root`, so without the inline
# override below npm/Playwright would dump ~/.npm (~830 MB) and
# ~/.cache/ms-playwright (~930 MB) into /home/worker as root-owned files —
# which previously required a `chown -R worker:worker /home/worker` step that
# re-wrote the entire HOME as a 5+ GB duplicate layer. By keeping HOME=/root
# and the npm cache in /tmp, then cleaning them in the same RUN, the chown
# becomes unnecessary.
RUN HOME=/root NPM_CONFIG_CACHE=/tmp/npm-cache \
    sh -c 'mkdir -p /opt/playwright \
      && cd /opt/global-deps-full && npm install --no-audit --no-fund \
      && for bin in /opt/global-deps-full/node_modules/.bin/*; do \
           ln -sf "$bin" "/usr/local/bin/$(basename "$bin")"; \
         done \
      && playwright install chromium' \
    && cd /opt/global-deps-full \
    && chromium_path="$(node -e 'const { chromium } = require("playwright"); process.stdout.write(chromium.executablePath())')" \
    && ldd "$chromium_path" | tee /tmp/chromium-ldd.txt \
    && ! grep -F "not found" /tmp/chromium-ldd.txt \
    && node -e 'const { chromium } = require("playwright"); (async () => { const browser = await chromium.launch({ headless: true, args: ["--no-sandbox"] }); const page = await browser.newPage(); await page.setContent("<main>chromium smoke ok</main>"); await browser.close(); })().catch((error) => { console.error(error); process.exit(1); });' \
    && ln -sfn "$chromium_path" /opt/playwright/chromium \
    && ab_bin="agent-browser-linux-$([ "$TARGETARCH" = "amd64" ] && echo x64 || echo "$TARGETARCH")" \
    && test -x "/opt/global-deps-full/node_modules/agent-browser/bin/$ab_bin" \
    && find /opt/global-deps-full/node_modules/agent-browser/bin -name 'agent-browser-*' ! -name "$ab_bin" -delete \
    && rm -rf /tmp/npm-cache /root/.npm /root/.cache \
    && chmod -R a+rX /opt/playwright

# agent-browser finds the browser through this stable symlink; the real path
# carries Playwright's build number (e.g. chromium-1208/chrome-linux/chrome).
# The npm package ships a native binary per platform (~70 MB for the seven
# of them); the prune above keeps only this image's TARGETARCH binary, and
# the `test -x` before it fails the build if upstream moves the binaries.
# The Node launcher (bin/agent-browser.js) only ever probes the exact
# platform name, so the others are never consulted.
# Chrome's user-namespace sandbox is unavailable under Docker's default seccomp
# profile and in BuildKit RUN steps ("No usable sandbox!"), so launch with
# --no-sandbox, exactly what Playwright does by default (chromiumSandbox:
# false). --disable-dev-shm-usage is the other Playwright default that matters
# in containers: /dev/shm is 64 MB and large pages crash the renderer without
# it. An explicit `--args` on the command line replaces this env, so callers
# who pass their own args must include --no-sandbox again.
ENV AGENT_BROWSER_EXECUTABLE_PATH=/opt/playwright/chromium \
    AGENT_BROWSER_ARGS=--no-sandbox,--disable-dev-shm-usage

# Build-time assert: agent-browser can drive that Chromium as the runtime
# user, headless. Its daemon leaves pid/socket sidecars in ~/.agent-browser,
# so wipe them in the SAME RUN. A stale pid file would confuse the runtime
# daemon lookup on first use.
USER worker
RUN agent-browser open about:blank \
    && agent-browser screenshot /tmp/agent-browser-smoke.png \
    && head -c 8 /tmp/agent-browser-smoke.png | grep -q PNG \
    && agent-browser close \
    && rm -rf /tmp/agent-browser-smoke.png /home/worker/.agent-browser
USER root

# Install the context-mode plugins for Claude + Codex (build-time cache).
# These are the ONLY marketplace plugins — they ship the ctx_* HOOKS, which a
# skills-only installer cannot replace. NOTE: the Claude plugin tracks the
# marketplace HEAD and is NOT version-pinned. A build-time `git checkout
# v${CONTEXT_MODE_VERSION}` in the marketplace clone does not work (git
# rejects it with "dubious ownership" and the clone is shallow without tags),
# so we don't attempt it. The ctx_* TOOLS are served by the globally-installed
# CLI (npm i -g context-mode in worker-base), which IS pinned; only the hook
# bundle floats — acceptable since the hooks are backward-compatible.
# Guarded with || true so a marketplace/registry hiccup can't fail the build.
# CRITICAL: clean ~/.bun/install/cache in the SAME RUN — plugin installs run
# `bun install` under the hood and previously left an 880 MB cache in a layer.
USER worker
RUN claude plugin marketplace add mksglu/claude-context-mode || true \
    && claude plugin install context-mode@context-mode --scope user || true \
    && codex plugin marketplace add mksglu/context-mode || true \
    && codex plugin add context-mode@context-mode || true \
    && rm -rf /home/worker/.bun/install/cache

USER root

# ─── Stage: worker-full — default/published image (must stay LAST) ───────────
FROM worker-full-base AS worker-full

# ==== leaf block — KEEP IN SYNC with the identical block in worker-slim ====
# Repo artifacts change on every code change; they live only in leaf stages so
# the heavy shared layers above never get invalidated by a src/ edit.

# Copy binary from builder.
# --chmod avoids a separate `RUN chmod` layer that would duplicate the binary.
COPY --from=builder --chmod=755 /build/agent-swarm /usr/local/bin/agent-swarm

# Optional helpers (postgres/redis only exist in the full image; the
# entrypoint guards on the binaries before invoking these)
COPY --chmod=755 scripts/init-local-postgres.sh /usr/local/bin/init-local-postgres.sh
COPY --chmod=755 scripts/init-local-redis.sh /usr/local/bin/init-local-redis.sh
COPY --chmod=755 scripts/install-repo-hooks.sh /usr/local/bin/install-repo-hooks.sh

# Copy commands / agents
COPY --chown=worker:worker plugin/commands/* /home/worker/.claude/commands/
COPY --chown=worker:worker plugin/agents/* /home/worker/.claude/agents/

# Copy pi-mono skills (used when HARNESS_PROVIDER=pi)
COPY --chown=worker:worker plugin/pi-skills/ /home/worker/.pi/agent/skills/

# Copy codex skills (used when HARNESS_PROVIDER=codex)
# Structure: plugin/commands/<name>.md -> ~/.codex/skills/<name>/SKILL.md
COPY --chown=worker:worker plugin/commands/ /tmp/codex-skills-src/
RUN mkdir -p /home/worker/.codex/skills && \
    for f in /tmp/codex-skills-src/*.md; do \
      [ -e "$f" ] || continue; \
      name=$(basename "$f" .md); \
      mkdir -p "/home/worker/.codex/skills/$name"; \
      cp "$f" "/home/worker/.codex/skills/$name/SKILL.md"; \
    done && \
    rm -rf /tmp/codex-skills-src && \
    chown -R worker:worker /home/worker/.codex/skills

# Mirror Claude-installed skills into every local harness skill tree (repo
# skills + `npx skills` installs). -L dereferences symlinks (npx skills may
# symlink into ~/.agents/skills).
# NOTE: chown ONLY the skill trees written here. A `chown -R` over the parent
# dotdirs (.opencode is 171 MB, .codex 90 MB) rewrites them into this layer
# (runbook rule 1) — previously a 270 MB layer for 88 KB of skills.
RUN mkdir -p /home/worker/.pi/agent/skills /home/worker/.codex/skills /home/worker/.opencode/skills /home/worker/.agents/skills && \
    cp -aL /home/worker/.claude/skills/. /home/worker/.pi/agent/skills/ || true && \
    cp -aL /home/worker/.claude/skills/. /home/worker/.codex/skills/ || true && \
    cp -aL /home/worker/.claude/skills/. /home/worker/.opencode/skills/ || true && \
    cp -aL /home/worker/.claude/skills/. /home/worker/.agents/skills/ || true && \
    chown -R worker:worker /home/worker/.pi/agent/skills /home/worker/.codex/skills \
      /home/worker/.opencode/skills /home/worker/.agents

# Copy opencode plugin (used when HARNESS_PROVIDER=opencode).
# OPENCODE_SWARM_PLUGIN_PATH (ENV in worker-base) tells OpencodeAdapter exactly
# where to find the plugin. The plugin entrypoint imports adjacent vendored
# helpers (`./opencode-auth`, `./summarize`) — opencode's plugin loader runs
# the TS files inside its own bundled Bun runtime, which only exposes
# `@opencode-ai/{plugin,sdk}`, so the helpers are vendored next to it. Tests
# live in a sibling `tests/` subdirectory and are intentionally NOT copied
# (opencode auto-discovers `.ts` files here and would load them as plugins).
RUN mkdir -p /home/worker/.config/opencode/plugins/lib && \
    chown -R worker:worker /home/worker/.config
COPY --chown=worker:worker plugin/opencode-plugins/agent-swarm.ts /home/worker/.config/opencode/plugins/agent-swarm.ts
COPY --chown=worker:worker plugin/opencode-plugins/lib/ /home/worker/.config/opencode/plugins/lib/

# Workspace directories (bind-mounted or volume-backed at runtime) + entrypoint
RUN mkdir -p /workspace/personal /workspace/shared /logs && \
    chown worker:worker /workspace /logs
COPY --chown=worker:worker --chmod=755 docker-entrypoint.sh /docker-entrypoint.sh

USER root
WORKDIR /workspace
# ==== end leaf block ====
