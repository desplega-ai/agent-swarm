#!/usr/bin/env bash
# Fake curl for the deploy tests: the public IP lookup, file:// downloads and
# health checks. Anything else fails, so a test never reaches the network.
set -euo pipefail
out="" url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o | --output) out="$2"; shift 2 ;;
    -m | --max-time) shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
case "$url" in
  https://checkip.amazonaws.com* | https://api.ipify.org* | https://ipv4.icanhazip.com*)
    echo "${FAKE_PUBLIC_IP:-203.0.113.7}"
    ;;
  file://*)
    if [ -n "$out" ] && [ "$out" != /dev/null ]; then cp "${url#file://}" "$out"; else cat "${url#file://}"; fi
    ;;
  */health) exit "${FAKE_HEALTH_EXIT:-0}" ;;
  *)
    echo "fake curl: no network in tests ($url)" >&2
    exit 22
    ;;
esac
