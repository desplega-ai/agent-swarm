        "type": "object",
        "properties": {
          "columns": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              {
                "type": "object",
                "properties": {
                  "base": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "sm": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "md": {
                    "type": "integer",
