                    "minimum": 1,
                    "maximum": 6
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "gap": {
            "type": "string",
            "enum": ["none", "xs", "sm", "md", "lg", "xl"]
          },
          "padding": {
            "type": "string",
            "enum": ["none", "xs", "sm", "md", "lg", "xl"]
          }
        },
        "additionalProperties": false
      }
    },
    "Split": {
      "description": "Two-pane layout. POSITIONAL children: the FIRST child is the left pane, the SECOND is the right pane, and any further children stack inside the right pane. `ratio` sizes them (1-1|1-2|2-1|1-3|3-1, default 2-1 = wide left). Below `collapseBelow` (sm|md|lg, default md) the panes stack vertically; `reverse` only flips that stacked order (right pane first on narrow screens).",
      "slots": ["default"],
      "props": {
