{
  "definitions": {
    "trigger_surface": {
      "type": "string",
      "description": "Surface that started a chain of work: agent-swarm's AgentTaskSourceSchema values plus other.",
      "enum": [
        "slack",
        "ui",
        "api",
        "mcp",
        "github",
        "gitlab",
        "linear",
        "jira",
        "agentmail",
        "schedule",
        "workflow",
        "system",
        "other"
      ]
    }
  },
  "common_properties": {
    "agent-swarm": {
      "swarmVersion": {
        "type": "string",
        "description": "agent-swarm version. Legacy key kept during the v1 window; v2 carries context.swarm_version."
      },
      "is_cloud": {
        "type": "boolean",
        "description": "Legacy key kept during the v1 window; v2 carries context.deployment."
      },
      "is_e2b": {
        "type": "boolean",
        "description": "Legacy key kept during the v1 window; v2 carries context.deployment."
      },
      "install_method": {
        "type": "string",
        "description": "Legacy key kept during the v1 window; v2 carries context.install_method."
      },
      "has_embedding_key": {
        "type": "boolean",
        "description": "An embedding API key is configured."
      },
      "has_slack_channel": {
        "type": "boolean",
        "description": "A Slack channel is configured."
      },
      "has_email_channel": {
        "type": "boolean",
        "description": "An email channel is configured."
      },
      "has_notification_channel": {
        "type": "boolean",
        "description": "A notification channel is configured."
      }
    }
  },
