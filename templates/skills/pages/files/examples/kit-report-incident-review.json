      "type": "Callout",
      "props": {
        "tone": "warning",
        "title": "Summary",
        "content": "The certificate had no automatic renewal, and its expiry reminders went to a mailbox nobody reads. Renewal is now automatic for all 14 certificates. Expiry alerts page the on-call engineer 21 days ahead."
      }
    },
