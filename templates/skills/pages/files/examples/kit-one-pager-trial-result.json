                      15,
                      16,
                      14,
                      12,
                      11,
                      11,
                      10,
                      11
                    ]
                  },
                  {
                    "name": "Westgate, queue as before",
                    "role": "baseline",
                    "values": [
                      15,
                      16,
                      16,
                      15,
                      16,
                      15,
                      16,
                      17,
                      15,
                      16
                    ]
                  }
                ],
                "yMin": 8
              },
              "note": "Source: dock sensor logs. Westgate is a store of similar size that kept the queue. The axis starts at 8 min."
