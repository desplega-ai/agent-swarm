              },
              {
                "type": "Field",
                "props": {
                  "label": "Vans",
                  "value": "14"
                }
              },
              {
                "type": "Field",
                "props": {
                  "label": "Slots",
                  "value": "15 min, booked in the driver app"
                }
              },
              {
                "type": "Field",
                "props": {
                  "label": "Compared with",
                  "value": "Westgate, same weeks"
                }
              },
              {
                "type": "Field",
                "props": {
                  "label": "Measured by",
