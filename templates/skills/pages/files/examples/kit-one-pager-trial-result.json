            "tone": "success",
            "compare": "vs 16 min before the trial"
          },
          {
            "label": "On-time departures",
            "value": "94%",
            "delta": "+6 pts",
            "tone": "success",
            "compare": "vs 88% before"
          },
          {
            "label": "Deliveries per shift",
            "value": "23",
            "delta": "+2",
            "tone": "success",
            "compare": "vs 21 before"
          },
          {
            "label": "Driver rating",
            "value": "4.4",
            "unit": "/ 5",
            "delta": "+0.8",
            "tone": "success",
            "compare": "vs 3.6 in the January survey"
          }
        ]
      }
    },
    "sections": [
      {
        "type": "Section",
