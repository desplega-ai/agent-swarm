      {
        "type": "Section",
        "props": {
          "layout": "split"
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "content": "### What it costs\n\nOne tablet at the loading dock and two hours of setup per store. The booking feature is already in the driver app."
            }
          },
          {
            "type": "Text",
            "props": {
              "content": "### Next step\n\nRoll out to Northgate, Riverside, Hollins and Westgate in April. Measure the same four numbers for six weeks."
            }
          }
        ]
      }
