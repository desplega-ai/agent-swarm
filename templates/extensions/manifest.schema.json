{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "runtime": {
      "type": "string",
      "enum": [
        "api",
        "worker"
      ]
    },
    "assets": {
      "type": "object",
      "properties": {
        "hooks": {
          "type": "string",
          "minLength": 1
        },
        "scripts": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Global script name. Must start with `<extension name>-`."
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "description": "Bundle path of the script source."
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "description": "Defaults to `description`.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "file",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "schedules": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Schedule name. Must start with `<extension name>-`."
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "script": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Name of a script declared in `assets.scripts`."
              },
              "cronExpression": {
                "type": "string",
                "minLength": 1
              },
              "intervalMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "name",
              "script"
            ],
            "additionalProperties": false
          }
        },
        "skills": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflows": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "hooks"
      ],
      "additionalProperties": false
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "author": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "description",
    "version",
    "runtime",
    "assets"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/desplega-ai/agent-swarm/blob/main/templates/extensions/manifest.schema.json",
  "title": "Agent Swarm extension manifest",
  "description": "Manifest for a predefined agent-swarm extension (templates/extensions/<name>/manifest.{yaml,yml,json}). Asset names must start with `<name>-`; schedules must reference a declared script and set exactly one of cronExpression or intervalMs. Those rules are enforced at build and install time, not by this schema."
}
