{
  "format": "swarm-app-bundle/v1",
  "app": {
    "id": "0d7e1c2a-5f3b-4c8e-9a61-7b2e4d9f1c35",
    "name": "ui-dev sample app",
    "description": "Synthetic fixture for bun run ui:dev --api local",
    "definition": {
      "models": {
        "item": {
          "columns": {
            "title": {
              "kind": "string"
            },
            "done": {
              "kind": "boolean"
            },
            "points": {
              "kind": "number"
            }
          }
        }
      },
      "queries": {
        "items": {
          "model": "item",
          "sort": {
            "column": "points",
            "dir": "asc"
          }
        }
      },
      "actions": {
        "ping": {
          "kind": "script",
          "scriptId": "5b0c6a1e-7c1d-4f43-9a0e-2d1f3c4b5a60"
        }
      },
      "defaultPage": "main",
      "pages": {
        "main": {
          "root": "root",
          "elements": {
            "root": {
              "type": "Stack",
              "props": {},
              "children": ["title", "pingBtn", "itemsTable"]
            },
            "title": {
              "type": "Heading",
              "props": {
                "text": "ui-dev sample app"
              }
            },
            "pingBtn": {
              "type": "Button",
              "props": {
                "label": "Ping"
              },
              "on": {
                "press": [
                  {
                    "action": "app.action",
                    "params": {
                      "name": "ping"
                    }
                  }
                ]
              }
            },
            "itemsTable": {
              "type": "Table",
              "props": {
                "data": {
                  "$state": "/queries/items/data"
                },
                "columns": [
                  {
                    "key": "title",
                    "label": "Item"
                  },
                  {
                    "key": "done",
                    "label": "Done"
                  },
                  {
                    "key": "points",
                    "label": "Points"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "rows": {
